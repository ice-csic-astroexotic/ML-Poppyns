{
  "name": "Convolution",
  "trials": 8,
  "convergence": {
    "h_c_threshold": 0.5,
    "vk_c_threshold": 10.0,
    "sigma_k_threshold": 10.0
  },
  "n_gpu": 1,

  "arch": {
    "type": "ModelConv",
    "args": {
        "input_shape": [4, 128, 128],
        "num_parameters": 2
    }
  },

  "weights_initializer": {
      "type": "InitializerKaiming",
      "args": {}
  },

  "training_data_loader": {
    "type": "LoaderMultichannelArray",
    "args": {
      "dataset_path": "examples/data/multiparameter/dataset_train.csv",
      "statistic_path": "examples/data/multiparameter/statistics_train.json",
      "batch_size": 8,
      "num_workers": 1,
      "filter_inputs": [1, 2, 6, 7],
      "filter_labels": [],
      "shuffle": true,
      "normalize": false,
      "standardize": false
    }
  },

  "validation_data_loader": {
    "type": "LoaderMultichannelArray",
    "args": {
      "dataset_path": "examples/data/multiparameter/dataset_valid.csv",
      "statistic_path": "examples/data/multiparameter/statistics_train.json",
      "batch_size": 8,
      "num_workers": 1,
      "filter_inputs": [1, 2, 6, 7],
      "filter_labels": [],
      "shuffle": false,
      "normalize": false,
      "standardize": false
    }
  },

  "test_data_loader": {
    "type": "LoaderMultichannelArray",
    "args": {
      "dataset_path": "examples/data/multiparameter/dataset_test.csv",
      "statistic_path": "examples/data/multiparameter/statistics_train.json",
      "batch_size": 1,
      "num_workers": 1,
      "filter_inputs": [1, 2, 6, 7],
      "filter_labels": [],
      "shuffle": false,
      "normalize": false,
      "standardize": false
    }
  },

  "optimizer": {
    "type": "Adam",
    "args":{
      "lr": 1e-5,
      "weight_decay": 0.0
    }
  },

  "loss": {
      "type": "LossRMSE",
      "args": {}
  },

  "metric": {
      "type": "MetricAccuracyRMSE",
      "args": {}
  },

  "lr_scheduler": {
    "type": "StepLR",
    "args": {
      "step_size": 1024,
      "gamma": 0.1
    }
  },

  "trainer": {
    "epochs": 1024,
    "save_dir": "examples/learning/saved",
    "save_period": 1000,
    "verbosity": 1,
    "early_stop": 128,
    "tensorboard": true
  }
}