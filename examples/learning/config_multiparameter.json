{
  "name": "Linear",
  "n_gpu": 1,

  "arch": {
    "type": "ModelLinear",
    "args": {
        "input_shape": [4, 128, 128],
        "num_parameters": 2
    }
  },

  "weights_initializer": {
      "type": "InitializerXavier",
      "args": {}
  },

  "data_loader": {
    "type": "LoaderMultichannelArray",
    "args": {
      "data_path": "examples/data/multiparameter/dataset.csv",
      "batch_size": 8,
      "num_workers": 1,
      "ignored_inputs": [1, 2, 6, 7],
      "ignored_labels": []
    }
  },

  "validation_data_loader": {
    "type": "LoaderMultichannelArray",
    "args": {
      "data_path": "examples/data/multiparameter/dataset.csv",
      "batch_size": 8,
      "num_workers": 1,
      "ignored_inputs": [1, 2, 6, 7],
      "ignored_labels": []
    }
  },

  "optimizer": {
    "type": "Adam",
    "args":{
      "lr": 1e-5,
      "weight_decay": 0.0
    }
  },

  "loss": {
      "type": "LossRMSE",
      "args": {}
  },

  "metric": {
      "type": "MetricAccuracyRMSE",
      "args": {}
  },

  "lr_scheduler": {
    "type": "StepLR",
    "args": {
      "step_size": 100,
      "gamma": 0.1
    }
  },

  "trainer": {
    "epochs": 2000,
    "save_dir": "examples/learning/saved",
    "save_period": 1,
    "verbosity": 1,
    "early_stop": 100,
    "tensorboard": true
  }
}
