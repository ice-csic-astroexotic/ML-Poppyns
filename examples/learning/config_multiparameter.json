{
  "name": "Linear",
  "trials": 8,
  "convergence": {
    "h_c_threshold": 0.01,
    "vk_c_threshold": 0.1,
    "sigma_k_threshold": 5.0
  },
  "n_gpu": 0,

  "arch": {
    "type": "ModelLinear",
    "args": {
        "input_shape": [4, 128, 128],
        "num_parameters": 1
    }
  },

  "weights_initializer": {
      "type": "InitializerKaiming",
      "args": {}
  },

  "data_loader": {
    "type": "LoaderMultichannelArray",
    "args": {
      "data_path": "examples/data/multiparameter/dataset.csv",
      "batch_size": 8,
      "num_workers": 1,
      "ignored_inputs": [1, 2, 6, 7],
      "ignored_labels": [8],
      "normalize": true,
      "standardize": false,
      "shuffle": true
    }
  },

  "validation_data_loader": {
    "type": "LoaderMultichannelArray",
    "args": {
      "data_path": "examples/data/multiparameter/dataset.csv",
      "batch_size": 8,
      "num_workers": 1,
      "ignored_inputs": [1, 2, 6, 7],
      "ignored_labels": [8],
      "normalize": true,
      "standardize": false
    }
  },

  "optimizer": {
    "type": "Adam",
    "args":{
      "lr": 1e-5,
      "weight_decay": 0.0
    }
  },

  "loss": {
      "type": "LossRMSE",
      "args": {}
  },

  "metric": {
      "type": "MetricAccuracyRMSE",
      "args": {}
  },

  "lr_scheduler": {
    "type": "StepLR",
    "args": {
      "step_size": 128,
      "gamma": 0.1
    }
  },

  "trainer": {
    "epochs": 1024,
    "save_dir": "examples/learning/saved",
    "save_period": 1000,
    "verbosity": 1,
    "early_stop": 32,
    "tensorboard": true
  }
}
