{
  "name": "Linear",
  "n_gpu": 1,

  "arch": {
    "type": "ModelLinear",
    "args": {
        "input_shape": [4, 64, 64],
        "num_parameters": 1
    }
  },

  "data_loader": {
    "type": "LoaderMultichannelArray",
    "args": {
      "data_path": "examples/data/8_64_array/dataset_array.csv",
      "batch_size": 1,
      "num_workers": 1,
      "ignored_inputs": [1]
    }
  },

  "optimizer": {
    "type": "SGD",
    "args":{
      "lr": 1e-2,
      "weight_decay": 0.0,
      "momentum": 0.9
    }
  },

  "loss": {
      "type": "LossRMSE",
      "args": {}
  },

  "metric": {
      "type": "MetricAccuracyCHI2",
      "args": {}
  },

  "lr_scheduler": {
    "type": "StepLR",
    "args": {
      "step_size": 100,
      "gamma": 0.1
    }
  },

  "trainer": {
    "epochs": 2000,

    "save_dir": "examples/learning/saved",
    "save_period": 1,
    "verbosity": 1,
    "early_stop": 100,
    "tensorboard": true
  }
}