{
  "name": "MNIST_LeNet",
  "n_gpu": 1,

  "arch": {
    "type": "ModelMNIST",
    "args": {}
  },

  "data_loader": {
    "type": "LoaderMNIST",
    "args": {
      "data_dir": "data/",
      "batch_size": 128,
      "num_workers": 2
    }
  },

  "optimizer": {
    "type": "Adam",
    "args":{
      "lr": 0.001,
      "weight_decay": 0,
      "amsgrad": true
    }
  },

  "loss": {
      "type": "LossNLL",
      "args": {}
  },

  "metric": {
      "type": "MetricAccuracy",
      "args": {}
  },

  "lr_scheduler": {
    "type": "StepLR",
    "args": {
      "step_size": 50,
      "gamma": 0.1
    }
  },

  "trainer": {
    "epochs": 100,

    "save_dir": "saved/",
    "save_period": 1,
    "verbosity": 2,
    "early_stop": 10,
    "tensorboard": true
  }
}