{
  "name": "SBI_ConvolutionMDN",
  "n_gpu": 1,
  "set_manual_seed": false,
  "manual_seed": 42,
  "profile_log": "profile.log",
  "profile_json": "profile.json",
  "show_profiling": true,

  "arch": {
    "type": "ModelConvSBI",
    "args": {
        "input_shape": [3, 32, 32],
        "len_output_layer": 32
    }
  },

  "weights_initializer": {
      "type": "InitializerKaiming",
      "args": {}
  },

  "density_estimator": {
    "type": "mdn",
    "args": {
      "num_components": 10
       }
  },

  "training_data_loader": {
    "dataset_path": "toremove/output_generator32/dataset_full.csv",
    "statistic_path": "toremove/output_generator32/statistics_full.json",
    "filter_inputs": [9, 10, 11],
    "filter_labels": [12, 13, 14, 15, 16],
    "normalize": false,
    "standardize": true
  },

  "test_data_loader": {
    "dataset_path": "toremove/output_generator32/dataset_full.csv",
    "statistic_path": "toremove/output_generator32/statistics_full.json",
    "filter_inputs": [9, 10, 11],
    "filter_labels": [12, 13, 14, 15, 16],
    "normalize": false,
    "standardize": true
  },

  "trainer": {
    "validation_fraction": 0.1,
    "batch_size": 1,
    "lr": 5e-4,
    "save_dir": "toremove/learning"
  },

  "infer": {
    "save_dir": "toremove/inference"
  }
}