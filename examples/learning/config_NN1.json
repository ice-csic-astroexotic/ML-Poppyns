{
  "name": "Net",
  "n_gpu": 1,

  "arch": {
    "type": "ModelNN1",
    "args": {
      "input_shape": [3, 512, 512],
      "num_parameters": 1
    }
  },

  "data_loader": {
    "type": "LoaderRGBImage",
    "args": {
      "data_path": "examples/data/1_samples/dataset.csv",
      "batch_size": 1,
      "num_workers": 1
    }
  },

  "optimizer": {
    "type": "Adam",
    "args":{
      "lr": 0.0001,
      "weight_decay": 0,
      "amsgrad": true
    }
  },

  "loss": {
      "type": "LossRMSE",
      "args": {}
  },

  "metric": {
      "type": "MetricAccuracyCHI2",
      "args": {}
  },

  "lr_scheduler": {
    "type": "StepLR",
    "args": {
      "step_size": 50,
      "gamma": 0.1
    }
  },

  "trainer": {
    "epochs": 200,

    "save_dir": "examples/learning/saved",
    "save_period": 1,
    "verbosity": 2,
    "early_stop": 20,
    "tensorboard": true
  }
}